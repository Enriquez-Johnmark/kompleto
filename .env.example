# Copy to .env for local runs. Real secrets never go in the repo.
DATABASE_URL=postgres://kompleto:kompleto@localhost:5432/kompleto
BIND_ADDR=127.0.0.1:3000
# The address you open in the browser, as scheme://host[:port]. Login links
# point here, and form posts must come from it. Required when BIND_ADDR is
# 0.0.0.0.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# mailpit (local, catches everything) or resend
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8025
MAIL_FROM_ADDRESS=reminders@getkompleto.test
# Only when MAIL_PROVIDER=resend:
# RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com
