  "query": "select c.business_name, r.period, r.from_address, r.subject, r.body_text, r.automatic, r.signed, r.received_at\n         from replies r join clients c on c.id = r.client_id and c.firm_id = r.firm_id\n         where r.firm_id = $1 order by r.received_at, r.id",
