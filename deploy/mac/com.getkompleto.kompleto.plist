<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the owner's Mac: starts Kompleto at login and
     restarts it if it stops. Install:
       cp deploy/mac/com.getkompleto.kompleto.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.getkompleto.kompleto.plist
     Settings come from ~/kompleto/kompleto.env (chmod 600), read by
     ~/kompleto/run.sh. Logs go to ~/kompleto/kompleto.log. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.getkompleto.kompleto</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string><string>exec "$HOME/kompleto/run.sh" serve</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/kompleto.log</string>
  <key>StandardErrorPath</key><string>/tmp/kompleto.log</string>
</dict>
</plist>
