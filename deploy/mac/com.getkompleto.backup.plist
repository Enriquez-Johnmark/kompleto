<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the nightly backup on the owner's Mac, at 02:17. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.getkompleto.backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string><string>exec "$HOME/kompleto/run.sh" backup</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>17</integer></dict>
  <key>StandardOutPath</key><string>/tmp/kompleto-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/kompleto-backup.log</string>
</dict>
</plist>
